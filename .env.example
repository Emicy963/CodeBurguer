# ── Google Sheets ────────────────────────────────────────────────────────────
# URL do Google Apps Script para registo de pedidos no Google Sheets
# Obtém este valor em: Extensions > Apps Script > Deploy > Manage Deployments
APPS_SCRIPT_URL=https://script.google.com/macros/s/SEU_SCRIPT_ID/exec

# ── Supabase ─────────────────────────────────────────────────────────────────
# URL do projecto Supabase — Settings > API > Project URL
SUPABASE_URL=https://xxxx.supabase.co

# Chave de serviço do Supabase — Settings > API > service_role (secret)
# ATENÇÃO: nunca expor esta chave no cliente
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Painel de Admin ───────────────────────────────────────────────────────────
# Username do administrador
ADMIN_USERNAME=admin

# SHA-256 da password do administrador
# Gera com: node -e "console.log(require('crypto').createHash('sha256').update('TUA_PASSWORD').digest('hex'))"
ADMIN_PASSWORD_HASH=

# String secreta aleatória para assinar os tokens de sessão do admin
ADMIN_TOKEN_SECRET=codeburger-secret-aqui
